# OSRM road routing. This public provider receives route coordinates.
# Replace with a self-hosted endpoint for private routing; empty uses straight lines.
ROUTING_BASE_URL=https://router.project-osrm.org/route/v1/driving
# Optional GPS history retention (integer >= 7 days). Unset preserves history.
# TRACKING_RETENTION_DAYS=90
# Only set this behind a known proxy; use its actual IP addresses or CIDR ranges.
# Do not use true or an arbitrary proxy hop count.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Enable only after the mobile_push_devices migration and native FCM/APNs setup.
EXPO_PUSH_ENABLED=false
# Optional Expo push access token when enhanced push security is enabled.
# EXPO_PUSH_ACCESS_TOKEN=
