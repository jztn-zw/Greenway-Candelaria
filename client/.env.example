# Set VITE_API_URL to the deployed/local GreenWay API's /api URL.
VITE_API_URL=http://localhost:3000/api

# Optional: set only if Socket.IO uses a separate origin. Omit /api.
# VITE_SOCKET_URL=http://localhost:3000

# Set this in Vercel for /posts/:id previews. Omit /api. If unset, the Vercel
# function falls back to the original GreenWay backend.
# GREENWAY_API_ORIGIN=http://localhost:3000

# Public URL of the approved Resident APK. If empty, the website tries
# /downloads/greenway-candelaria.apk, which is absent from the handover ZIP.
# Cross-origin hosts should send Content-Disposition: attachment for direct downloading.
VITE_RESIDENT_APK_URL=
